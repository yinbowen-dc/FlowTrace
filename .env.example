# Server-side Google OAuth web client; keep real values in ignored .env.local.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
AUTH_PUBLIC_ORIGIN=https://www.darkchunk.win
# Authorized redirect URI:
# https://www.darkchunk.win/collect/auth/google/callback
# Request only openid, email and profile. No mail/drive or offline access.
